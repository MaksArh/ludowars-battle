FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Vite читает VITE_* переменные на этапе build.
# Для Railway Docker builder задавайте их как Build Args.
ARG VITE_NAKAMA_HOST
ARG VITE_NAKAMA_USE_SSL
ARG VITE_NAKAMA_PORT
ARG VITE_NAKAMA_SERVER_KEY
ENV VITE_NAKAMA_HOST=${VITE_NAKAMA_HOST} \
    VITE_NAKAMA_USE_SSL=${VITE_NAKAMA_USE_SSL} \
    VITE_NAKAMA_PORT=${VITE_NAKAMA_PORT} \
    VITE_NAKAMA_SERVER_KEY=${VITE_NAKAMA_SERVER_KEY}

RUN npm run build

FROM node:20-alpine AS runtime
WORKDIR /app

# Railway прокидывает PORT; будем слушать его.
ENV NODE_ENV=production

RUN npm i -g serve@14.2.4

COPY --from=build /app/dist ./dist

EXPOSE 3000
CMD ["sh", "-c", "serve -s dist -l ${PORT:-3000}"]

